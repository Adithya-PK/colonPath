# ============================================================
# COLONPATH-AI V2 Root .gitignore
# ============================================================

# --- OS & IDE ---
.DS_Store
Thumbs.db
*.iml
.idea/
.vscode/

# --- Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
*.log

# --- Large Model Files & Weights (>100MB GitHub limit) ---
**/*.pth
**/*.pt
**/*.bin
**/*.onnx
**/*.h5
**/*.tar
**/*.tar.gz
**/hovernet_original_consep_type_tf2pytorch*

# --- Datasets & Parquet Files (>100MB) ---
**/*.parquet
**/datasets/conic2022/data/
**/.cache/
**/huggingface/

# --- Backend Outputs & Database ---
*.db
*.sqlite3
backend/colonpath_ai/outputs/uploads/
cv/outputs/uploads/

# --- Android Build & Local Configuration ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/
*.apk
*.aab
